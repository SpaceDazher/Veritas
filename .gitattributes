# Frozen contracts and evidence are byte-addressed. Keep their checkout bytes
# identical across Windows and POSIX hosts.
.gitattributes text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
*.json text eol=lf
# These two Stage-1 evidence copies are bound to the original raw CRLF bytes.
# Text normalization changes their SHA-256, so store and check them byte-for-byte.
evidence/external/s1-007/evaluation-record.json -text -diff
evidence/external/s1-009/evaluation-record.json -text -diff
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
