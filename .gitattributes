# Frozen contracts and evidence are byte-addressed. Keep their checkout bytes
# identical across Windows and POSIX hosts.
.gitattributes text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
