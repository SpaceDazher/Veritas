{
  "$schema": "https://arch-map.local/policy.schema.json",
  "version": 1,
  "name": "Veritas",
  "include": [
    "**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.arch-map/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.bb/chats/**",
    "**/Stage 2/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/migrations/**",
    "**/results/**",
    "**/evidence/**",
    "**/corpus/**"
  ],
  "components": [
    {
      "id": "app",
      "name": "Next.js app (внешний)",
      "match": [
        "src/app/**"
      ],
      "level": 0
    },
    {
      "id": "ui",
      "name": "React-компоненты",
      "match": [
        "src/components/**"
      ],
      "level": 0
    },
    {
      "id": "db",
      "name": "доступ к данным",
      "match": [
        "src/db/**"
      ],
      "level": 1
    },
    {
      "id": "domain",
      "name": "lib (внутренний слой)",
      "match": [
        "src/lib/**"
      ],
      "level": 2
    },
    {
      "id": "contracts",
      "name": "контракты",
      "match": [
        "contracts/**"
      ],
      "level": 1
    },
    {
      "id": "scripts",
      "name": "скрипты",
      "match": [
        "scripts/**"
      ],
      "level": 0
    },
    {
      "id": "docs",
      "name": "документация",
      "match": [
        "docs/**",
        "tasks/**",
        "pilots/**"
      ],
      "level": 1
    }
  ],
  "metrics": {
    "coverage": [
      "coverage/lcov.info",
      "**/coverage-final.json"
    ],
    "mutation": [
      "reports/mutation.json",
      "reports/mutation/mutation.json"
    ]
  },
  "thresholds": {
    "crap": 30,
    "cc": 12,
    "coverage": 0.8,
    "mutation": 0.75,
    "lines": 1500
  },
  "notes": "Next.js-приложение. app/components/scripts — внешний слой (уровень 0), db и contracts — инфраструктура (1), src/lib — доменная логика (2). Зависимости должны идти внутрь: app -> lib, но не lib -> app. tests, migrations, corpus, results и evidence исключены: карта показывает систему, а не её артефакты."
}