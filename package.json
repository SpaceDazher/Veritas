{
  "name": "veritas-agent-board",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded S2-001 product contract and synthetic Veritas Agent Board workspace",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:identity": "node --test --test-concurrency=1 \"tests/identity/*.test.mjs\"",
    "test:sandbox": "node --test \"tests/identity/sandbox.test.mjs\"",
    "test:security-probes": "node scripts/security-probes.mjs",
    "test:ingestion": "node --test --test-concurrency=1 \"tests/ingestion/*.test.mjs\"",
    "ingestion:types": "node scripts/generate-ingestion-types.mjs --write",
    "test:s2-003-security-probes": "node scripts/s2-003-security-probes.mjs",
    "test:s2-004-security-probes": "node scripts/s2-004-security-probes.mjs",
    "verify:s2-004": "node scripts/verify-s2-004.mjs",
    "verify:s2-004-db-replay": "node scripts/s2-004-db-replay.mjs",
    "test:claims": "node --test --test-concurrency=1 \"tests/claims/*.test.mjs\"",
    "verify:s2-003": "node scripts/verify-s2-003.mjs",
    "verify:s2-002": "node scripts/verify-s2-002.mjs",
    "verify:s2-003-dependencies": "node scripts/verify-s2-003-dependencies.mjs",
    "verify:s2-004-dependencies": "node scripts/verify-s2-004-dependencies.mjs",
    "claims:types": "node scripts/generate-claim-types.mjs --write && node scripts/generate-claim-types.mjs",
    "verify:s2-002-dependencies": "node scripts/verify-s2-002-dependencies.mjs",
    "verify:podman-sandbox": "node scripts/verify-podman-sandbox.mjs",
    "verify:gvisor-sandbox": "node scripts/verify-gvisor-sandbox.mjs",
    "verify:postgres-smoke": "node scripts/verify-postgres-smoke.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "verify:draft": "node scripts/verify.mjs draft",
    "verify:acceptance": "node scripts/verify.mjs acceptance",
    "verify:pilot-binding": "node scripts/verify-pilot-binding.mjs",
    "verify:clean-checkout": "node scripts/verify-clean-checkout.mjs",
    "test:policy": "node scripts/policy-probes.mjs",
    "test:acceptance-gate": "node scripts/acceptance-gate.mjs --test",
    "inventory:check": "node scripts/check-inventory.mjs",
    "inventory:write": "node scripts/check-inventory.mjs --write",
    "manifest:write": "node scripts/generate-manifests.mjs --write",
    "manifest:closure": "node scripts/generate-manifests.mjs --write-closure",
    "manifest:check": "node scripts/generate-manifests.mjs --check",
    "verify:s2-003-db-replay": "node scripts/s2-003-db-replay.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.44.0",
    "next": "^16.3.4",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "^8.20.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
