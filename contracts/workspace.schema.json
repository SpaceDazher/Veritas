{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/workspace.schema.json",
  "title": "Veritas Workspace (S2-002)",
  "description": "Bounded workspace with explicit scope, ACL, retention, filesystem roots and network profile. Unknown fields and versions are rejected fail-closed. JSON fields never prove identity or authority by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "workspace_id",
    "owner",
    "scope",
    "acl",
    "retention",
    "allowed_roots",
    "network_profile",
    "revision"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "workspace_id": { "$ref": "#/$defs/workspaceId" },
    "owner": { "$ref": "#/$defs/principalId" },
    "scope": { "enum": ["private", "project", "shared"] },
    "acl": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "role_id"],
        "properties": {
          "principal_id": { "$ref": "#/$defs/principalId" },
          "role_id": { "$ref": "#/$defs/roleId" }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["retain_until_revocation", "delete_after", "archive_on_closure"] },
        "delete_after_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "const": "delete_after" } }, "required": ["policy"] },
          "then": { "required": ["delete_after_days"] }
        }
      ]
    },
    "allowed_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "network_profile": { "enum": ["deny_all", "allowlisted"] },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "workspaceId": { "type": "string", "pattern": "^ws-[a-z0-9][a-z0-9-]{0,62}$" },
    "principalId": { "type": "string", "pattern": "^prn-[a-z0-9][a-z0-9-]{0,62}$" },
    "roleId": { "type": "string", "pattern": "^rol-[a-z0-9][a-z0-9-]{0,62}$" }
  }
}
