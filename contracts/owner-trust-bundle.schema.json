{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/owner-trust-bundle.schema.json",
  "title": "Veritas Owner Trust Bundle (S2-006)",
  "description": "Operator-controlled trust anchors for an owner-input package. This file must be supplied separately from the untrusted package. Real secret material is local-only and must never be committed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "bundleId", "fixtureGrade", "principals", "keys", "grants"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "bundleId": { "type": "string", "pattern": "^otb-[a-z0-9][a-z0-9-]{0,62}$" },
    "fixtureGrade": { "type": "boolean" },
    "principals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "roles", "workspaces"],
        "properties": {
          "principal": { "$ref": "#/$defs/principalId" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "workspaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyRef", "secret", "custodian", "role"],
        "properties": {
          "keyRef": { "type": "string", "minLength": 1 },
          "secret": { "type": "string", "minLength": 16 },
          "custodian": { "$ref": "#/$defs/principalId" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grant", "issuer", "signature"],
        "properties": {
          "grant": { "$ref": "https://veritas.local/contracts/semantic-provider-grant.schema.json" },
          "issuer": { "$ref": "#/$defs/principalId" },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "keyRef", "digest", "verified", "attestedBy"],
            "properties": {
              "scheme": { "const": "hmac-sha256" },
              "keyRef": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/sha256Hex" },
              "verified": { "const": true },
              "attestedBy": { "$ref": "#/$defs/principalId" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "principalId": { "type": "string", "pattern": "^prn-[a-z0-9][a-z0-9-]{0,62}$" },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
