{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/needs-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "NEEDS_INPUT"
    },
    "owner": {
      "const": "user"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "status",
    "owner",
    "blocks",
    "reason"
  ]
}
