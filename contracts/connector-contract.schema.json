{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/connector-contract.schema.json",
  "description": "Versioned adapter contract. A connector is read-only by construction: it discovers capabilities, resolves descriptors, fetches versions, extracts and reconciles. It never receives rights from source content and never mutates the source.",
  "title": "Veritas Connector Contract (S2-003)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "connector_id",
    "connector_version",
    "source_kind",
    "auth_mode",
    "read_only",
    "operations",
    "limits",
    "reconciliation",
    "terminal_states"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "connector_id": { "$ref": "#/$defs/connectorId" },
    "connector_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_kind": { "$ref": "#/$defs/sourceKind" },
    "auth_mode": { "enum": ["none", "grant_required", "blocked_without_credential"] },
    "required_grant_scope": {
      "oneOf": [
        { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]*$" },
        { "type": "null" }
      ]
    },
    "read_only": { "const": true },
    "sandbox_profile_id": {
      "oneOf": [
        { "type": "string", "pattern": "^sbx-[a-z0-9][a-z0-9-]{0,62}$" },
        { "type": "null" }
      ]
    },
    "capability_id": {
      "oneOf": [
        { "type": "string", "pattern": "^cap-[a-z0-9][a-z0-9.-]{0,62}$" },
        { "type": "null" }
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoverCapabilities",
        "resolveDescriptor",
        "fetchVersion",
        "extract",
        "reconcile",
        "observeDeletion"
      ],
      "properties": {
        "discoverCapabilities": { "const": true },
        "resolveDescriptor": { "const": true },
        "fetchVersion": { "const": true },
        "extract": { "const": true },
        "reconcile": { "const": true },
        "observeDeletion": { "const": true }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_attempts", "max_bytes"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "rate_limit_per_minute": { "type": "integer", "minimum": 1 }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "unknown_outcome_policy"],
      "properties": {
        "supported": { "type": "boolean" },
        "unknown_outcome_policy": {
          "enum": ["RECONCILIATION_REQUIRED", "BLOCKED_CONNECTOR"]
        }
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "COMMITTED",
          "BLOCKED_CONNECTOR",
          "ACCESS_DENIED",
          "TOMBSTONED",
          "QUARANTINED",
          "FAILED",
          "CANCELLED",
          "RECONCILIATION_REQUIRED"
        ]
      }
    }
  },
  "$defs": {
    "connectorId": { "type": "string", "pattern": "^conn-[a-z0-9][a-z0-9._-]{0,62}$" },
    "sourceKind": {
      "enum": [
        "markdown_obsidian",
        "web_url",
        "pdf",
        "github",
        "telegram",
        "youtube",
        "arxiv_huggingface",
        "manual_export"
      ]
    }
  }
}
