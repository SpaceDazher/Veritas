{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/role.schema.json",
  "title": "Veritas Role (S2-002)",
  "description": "A role is only a named, non-empty set of concrete capabilities. Wildcards and pattern references are forbidden: authority must be enumerable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "role_id", "name", "description", "capabilities"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "role_id": { "$ref": "#/$defs/roleId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityId" }
    }
  },
  "$defs": {
    "roleId": { "type": "string", "pattern": "^rol-[a-z0-9][a-z0-9-]{0,62}$" },
    "capabilityId": { "type": "string", "pattern": "^cap-[a-z0-9][a-z0-9.-]{0,61}[a-z0-9]$" }
  }
}
