{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/contracts/content-segment.schema.json",
  "description": "One addressable piece of extracted content bound to an immutable snapshot. Coordinates locate the segment inside the source; the digest pins its exact bytes. Embedded-instruction classification is data-only metadata: it never triggers actions and never extends authority.",
  "title": "Veritas Content Segment (S2-003)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "segment_id",
    "snapshot_id",
    "source_id",
    "ordinal",
    "coordinates",
    "text_sha256",
    "extraction",
    "status"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "segment_id": { "$ref": "#/$defs/segmentId" },
    "snapshot_id": { "$ref": "#/$defs/snapshotId" },
    "source_id": { "$ref": "#/$defs/sourceId" },
    "ordinal": { "type": "integer", "minimum": 0 },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "timecode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_ms", "end_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "text": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "Normalized segment text; may be null for FAILED/QUARANTINED segments."
    },
    "text_sha256": { "$ref": "#/$defs/sha256Hex" },
    "original_language": {
      "oneOf": [{ "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$" }, { "type": "null" }]
    },
    "normalized_language": {
      "oneOf": [{ "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$" }, { "type": "null" }]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "extractor_name", "extractor_version", "confidence"],
      "properties": {
        "method": { "enum": ["native_text", "parser", "ocr", "asr", "manual_export"] },
        "extractor_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extractor_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "config_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256Hex" }, { "type": "null" }]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "LOW_CONFIDENCE",
              "MISSING_RANGES",
              "UNDECODABLE_BYTES",
              "OCR_NOISY",
              "ASR_NOISY",
              "LANGUAGE_UNCERTAIN",
              "TRUNCATED"
            ]
          }
        },
        "missing_ranges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_count": { "type": "integer", "minimum": 0 },
        "line_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "embedded_instruction_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "classification"],
      "properties": {
        "present": { "type": "boolean" },
        "classification": {
          "enum": ["none", "instruction_attempt", "prompt_injection_suspect", "authority_claim"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": {
          "oneOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }]
        }
      },
      "description": "Data-only metadata. A segment that claims authority stays untrusted content; this block never triggers tools and never changes policy."
    },
    "status": { "enum": ["COMPLETE", "PARTIAL", "FAILED", "QUARANTINED"] }
  },
  "$defs": {
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "segmentId": { "type": "string", "pattern": "^seg-[a-z0-9][a-z0-9-]{0,62}$" },
    "snapshotId": { "type": "string", "pattern": "^snp-[a-z0-9][a-z0-9-]{0,62}$" },
    "sourceId": { "type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]{0,62}$" }
  }
}
