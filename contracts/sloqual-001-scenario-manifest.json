  ],
  "arrivalModel": {
    "mode": "open_loop",
    "rule": "Every arrival instant is computed up front from the scenario rate and the seed; a request that is dispatched late is still measured against its planned instant (response_complete - scheduled_send). Slow responses therefore accumulate into measured latency instead of silently reducing the offered load (no coordinated omission).",
    "latencyDefinition": "latency_ms = (response_complete_ns - scheduled_send_ns) / 1e6",
    "latenessDefinition": "lateness_ms = (dispatch_start_ns - scheduled_send_ns) / 1e6",
    "clock": "process.hrtime.bigint monotonic"
  },
  "policyEngine": {
    "module": "src/lib/identity/policy-engine.mjs",
    "fixedClock": "2026-09-12T12:00:00.000Z",
    "clockRule": "The engine clock is injected and never read from the system, so decisions are reproducible byte-for-byte for the same input. Time-based denials (expired grants, expired leases) are therefore fixed, not wall-clock dependent."
  },
  "warmupPolicy": {
    "requestsPerScenarioSeed": 10,
    "rule": "The first 10 requests of every non-security scenario-seed are a declared warmup. They are dispatched and judged exactly like every other request (hard counters, decision sequence, raw observations) but are excluded from the latency and lateness statistics, so the warm SLI describes warm behaviour rather than first-call JIT cost.",
    "securityFamilyWarmup": "none; the revocation family measures commit-to-deny latency, where a warmup would only add unrelated trials"
  },
  "seeds": [11, 12, 13, 14, 15],
  "families": {
    "steady": "Warm steady-state traffic; aggregate of this family is the warm latency SLI.",
    "burst": "Arrival bursts with zero inter-arrival spacing inside the burst window; aggregate is the burst latency SLI.",
    "fault": "Injected in-process faults (engine recreation, principal freeze, single-use grant replay).",
    "soak": "Sustained pilot-scale run; pilot duration only, not the full-scale soak requirement.",
    "security": "S1-008 revocation gate trials."
  },
