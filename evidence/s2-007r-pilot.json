    "findings": [
      {
        "id": "TRANSPORT_PUBLISHES_NO_TERMINATION_PROOF_ON_TIMEOUT",
        "detail": "the timeout arm reached outcome TIMEOUT with transport.cancelProof === null; the group kill ran but nothing publishes the observer's verdict for it",
        "consequence": "A-MVP-04's timeout clause is NOT_RUN: the proof the SPEC asks for does not exist to be quoted"
      }
    ],
    "findings_also": [
      {
        "id": "TRANSPORT_TIMER_NEVER_CLEARED",
        "detail": "the transport's granted-deadline timer is not cleared when a run reaches a terminal state, so a process whose work finished in 4s stayed alive for the full timeout_ms (measured: 5m01s wall for 4s of work)",
        "owner": "src/lib/executors/transport.mjs"
      },
      {
        "id": "CANCEL_PROOF_IS_A_REAPING_RACE",
        "detail": "the observer's survivor count is taken before the killed child is reaped, so a dead-but-unreaped child is counted as a survivor and a correct cancel is reported as SURVIVORS_REMAINING. The transport then escalates to UNKNOWN_OUTCOME, which is fail-closed and safe, but it makes A-MVP-04's cancel clause unobservable as TERMINATED on this host.",
        "owner": "src/lib/executors/transport.mjs + src/lib/identity/process-observer.mjs"
      }
    ]
  },
  "the_blocker": {
    "what": "policy.assertSandboxExecutable refuses the HOST_UNISOLATED floor tier, and policy.assertAdapterCoversTask calls it for every task edge",
    "where": "src/lib/agentboard/policy.mjs:777 (assertSandboxExecutable) called from src/lib/agentboard/policy.mjs:1263 (assertAdapterCoversTask)",
    "measured": {
      "assertLiveExecutionAuthorized(sbx-host-unisolated-v1, {authorization: <permit>, now: <injected>})": "ADMITTED, tier HOST_UNISOLATED, authorization_id aut-hu-s2-007r-01",
      "assertSandboxExecutable(sbx-host-unisolated-v1)": "BLOCKED_SANDBOX",
      "tasks.claim on a floor-tier task": "REFUSE / BLOCKED_SANDBOX (all four cells, both tasks each)",
      "dispatch.plan": "excluded the only candidate with the closed-set reason SANDBOX_NOT_PROVEN",
      "reproduced_in": "results/s2-007r/lifecycle-record.json#board_gate"
    },
    "consequence": "READY->CLAIMED, CLAIMED->RUNNING and RUNNING->IN_REVIEW are all unreachable on this profile, so there is no governed run, no A-MVP-06 race, no A-MVP-07 replay, and no comparison cell",
    "why_it_was_not_worked_around": "the only two ways forward are (a) edit a frozen S2-002/S2-007 target that is digest-bound in evidence/frozen-manifest.json, which this pilot may not do and which the orchestrator reseals by its own procedure, or (b) name a PROVEN profile for a process that never entered a container, which is the one thing rule 2 of this ticket forbids. Neither was done.",
    "the_one_line_that_would_unblock_it": "in assertSandboxExecutable, admit the floor tier as a DECLARED tier (isHostUnisolatedSandboxProfile) instead of requiring isExecutableSandboxProfile, and leave assertLiveExecutionAuthorized as the single live gate that demands the permit. That keeps the floor out of PROVEN_SANDBOX_PROFILE_IDS, keeps the permit mandatory at execution.start and dispatch.tick, and changes no existing control for a proven profile. It is a one-line change to a frozen file and it is the owner's call, not this pilot's."
  },
